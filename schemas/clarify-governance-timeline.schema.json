{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailuros.dev/schemas/clarify-governance-timeline.schema.json",
  "title": "Clarify Governance Timeline",
  "description": "JSON Schema for the Clarify-produced Ailuros governance timeline contract (Phase 1.5 contract hardening, not Phase 2 transport).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ailuros.timeline.v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event",
          "run_id",
          "timestamp"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          },
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
