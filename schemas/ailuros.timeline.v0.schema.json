{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailuros.dev/schemas/ailuros.timeline.v0.schema.json",
  "title": "Ailuros Timeline v0",
  "description": "Formal JSON Schema contract for the Ailuros governance timeline artifact. This is an offline evidence contract, not HTTP ingestion.",
  "$comment": "EVALUATION_RESULT quality_signals strict checking (required fields, boolean type) is enforced in the Python validator (validate_clarify_evidence_bundle.py) rather than in this schema, because JSON Schema conditional (if/then) logic would add unnecessary complexity for nested required/type constraints. See docs/contracts/ailuros-timeline-v0.md.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ailuros.timeline.v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event",
          "run_id",
          "timestamp"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "INPUT_CLASSIFIED",
              "LLM_REQUEST",
              "LLM_RESPONSE",
              "EVALUATION_RESULT",
              "OUTPUT_GENERATED",
              "RUN_COMPLETED"
            ]
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object"
          },
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
